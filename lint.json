enes\\Desktop\\test\\src\\pages.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\pages\\CashierPOS.jsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadData'. Either include it or remove the dependency array.","line":39,"column":6,"nodeType":"ArrayExpression","endLine":39,"endColumn":12,"suggestions":[{"desc":"Update the dependencies array to be: [loadData, user]","fix":{"range":[1265,1271],"text":"[loadData, user]"}}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react'\nimport { api } from '@/api'\nimport { useAuth } from '@/lib/AuthContext'\nimport OrderForm from '@/components/orders/OrderForm'\nimport PageHeader from '@/components/shared/PageHeader'\nimport { toast } from 'sonner'\nimport { CheckCircle2, RefreshCcw } from 'lucide-react'\n\nexport default function CashierPOS() {\n  const { user } = useAuth()\n  const [menuItems, setMenuItems] = useState([])\n  const [recentOrders, setRecentOrders] = useState([])\n  const [loading, setLoading] = useState(true)\n  const [submitting, setSubmitting] = useState(false)\n\n  const loadData = () => {\n    setLoading(true)\n    Promise.all([\n      api.menuItems.list(),\n      api.orders.list(50) // Fetch recent orders for summary\n    ]).then(([m, o]) => {\n      setMenuItems(m)\n      \n      // Filter for today's orders by this cashier\n      const today = new Date().toISOString().split('T')[0]\n      const myRecentOrders = o.filter(\n        order => order.order_date === today && \n                 order.cashier_name === (user?.full_name || user?.username) &&\n                 order.status === 'completed'\n      )\n      setRecentOrders(myRecentOrders)\n    }).finally(() => {\n      setLoading(false)\n    })\n  }\n\n  useEffect(() => {\n    loadData()\n  }, [user]) // loadData relies on user, ignoring missing dependency warning is fine for this wrapper.\n\n  const handleSubmit = async (orderData) => {\n    setSubmitting(true)\n    try {\n      await api.orders.create({\n        ...orderData,\n        cashier_name: user?.full_name || user?.username || 'Unknown',\n      })\n      toast.success('Order placed successfully!')\n      loadData() // Refresh screen to update shift summary\n    } finally {\n      setSubmitting(false)\n    }\n  }\n\n  const shiftTotal = recentOrders.reduce((sum, o) => sum + (o.total_amount || 0), 0)\n\n  return (\n    <div className=\"flex flex-col h-full overflow-hidden\">\n      <div className=\"flex justify-between items-end mb-6\">\n        <PageHeader title=\"Point of Sale\" subtitle={`Welcome, ${user?.full_name || 'Cashier'}`} />\n        \n        {/* Shift Summary Mini-Widget */}\n        <div className=\"flex gap-4\">\n          <div className=\"bg-card border rounded-lg px-4 py-2 flex items-center gap-3\">\n            <div className=\"bg-primary/10 text-primary p-2 rounded flex-shrink-0\">\n              <CheckCircle2 className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <p className=\"text-xs text-muted-foreground font-medium uppercase tracking-wide\">Shift Orders</p>\n              <p className=\"font-bold text-lg leading-none\">{recentOrders.length}</p>\n            </div>\n          </div>\n          <div className=\"bg-card border rounded-lg px-4 py-2 flex items-center gap-3\">\n            <div className=\"bg-green-100 text-green-700 p-2 rounded flex-shrink-0\">\n              <RefreshCcw className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <p className=\"text-xs text-muted-foreground font-medium uppercase tracking-wide\">Shift Revenue</p>\n              <p className=\"font-bold text-lg leading-none\">₱{shiftTotal.toLocaleString()}</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"flex-1 min-h-0\">\n        <OrderForm menuItems={menuItems} onSubmit={handleSubmit} loading={submitting || loading} />\n      </div>\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\pages\\Dashboard.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\pages\\Login.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\pages\\Orders.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\pages\\Products.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\pages\\SupplyChain.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\src\\utils\\index.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\tailwind.config.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\kenes\\Desktop\\test\\vite.config.js","messages":[],"